// Wi-Fi credentials and OTA password used by src/main.cpp.
//
// Copy this file to include/wifi.h (which is excluded from Git)
// and put your own network name and password in the copy:
//
//   cp include/wifi.h.example include/wifi.h
#pragma once

const char *ssid = "NETWORK_NAME";
const char *password = "PASSWORD";

// Password asked for updates over Wi-Fi (OTA). Remove this line to
// disable OTA: the firmware then only accepts updates over USB.
#define OTA_PASSWORD "OTA_PASSWORD"
